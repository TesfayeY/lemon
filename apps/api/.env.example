# Lemon API - Local Development Environment
# Copy to .env and fill in values

NODE_ENV=development
PORT=3000

# MongoDB - use a local replica set for transaction support
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB_NAME=lemon

# Firebase - project ID must match firebase.json
FIREBASE_PROJECT_ID=lemon-dev

# Firebase emulator hosts (required for non-production)
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Media (local dev storage; never commit uploads)
MEDIA_MAX_BYTES=10485760
MEDIA_LOCAL_DIR=./.local-media

# Discovery: HMAC secret for signed cursors (32+ chars, required in production;
# dev falls back to a random per-process secret). Generate: openssl rand -base64 48
# DISCOVERY_CURSOR_SECRET=
PASS_COOLDOWN_DAYS=30
