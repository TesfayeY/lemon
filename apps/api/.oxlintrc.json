{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "import",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "typescript/no-explicit-any": "error",
    "no-underscore-dangle": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": ["expect", "expectContract"]
      }
    ]
  },
  "ignorePatterns": [
    "dist/**"
  ]
}
