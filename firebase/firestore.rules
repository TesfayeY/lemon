rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default: deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Chat access projection - server-written, clients read own doc
    match /chatAccess/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // Server-only via Admin SDK
    }

    // Chat rooms - participants can read active rooms only
    match /rooms/{roomId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participantUids
        && resource.data.status == 'active'
        && isParticipantEnabled(request.auth.uid);
      allow write: if false; // Server-only via Admin SDK

      // Messages within a room
      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.participantUids
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.status == 'active'
          && isParticipantEnabled(request.auth.uid);
        allow write: if false; // Server-only via Admin SDK
      }

      // Read states
      match /readStates/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false; // Server-only via Admin SDK
      }
    }

    function isParticipantEnabled(uid) {
      return get(/databases/$(database)/documents/chatAccess/$(uid)).data.enabled == true;
    }
  }
}
