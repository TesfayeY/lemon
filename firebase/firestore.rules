rules_version = '2';

// Firestore holds chat only. Express writes everything through the Admin SDK,
// which bypasses these rules, so every client write is denied and reads are
// limited to active rooms whose two participants both have enabled access.
// Clients attach listeners to explicit room IDs returned by Express; room
// collection listing is never allowed.
service cloud.firestore {
  match /databases/{database}/documents {

    // Default: deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Chat access projection - server-written, clients read own doc
    match /chatAccess/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Chat rooms - participants can read active rooms only
    match /rooms/{roomId} {
      allow get: if canReadRoom(resource.data);
      allow list, write: if false;

      // Messages within a room - members of a readable room may get one message
      // or run history queries of at most 30 (R-CHAT-06); unbounded lists fail
      match /messages/{messageId} {
        allow get: if canReadRoom(roomData(roomId));
        allow list: if request.query.limit <= 30 && canReadRoom(roomData(roomId));
        allow write: if false;
      }

      // Read states - each member reads only their own marker
      match /readStates/{uid} {
        allow get: if signedIn() && request.auth.uid == uid && canReadRoom(roomData(roomId));
        allow list, write: if false;
      }
    }

    function signedIn() {
      return request.auth != null;
    }

    function roomData(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data;
    }

    // Exactly two distinct participant UIDs
    function hasValidParticipants(room) {
      return room.participantUids is list
        && room.participantUids.size() == 2
        && room.participantUids[0] is string
        && room.participantUids[1] is string
        && room.participantUids[0] != room.participantUids[1];
    }

    function accessEnabled(uid) {
      let path = /databases/$(database)/documents/chatAccess/$(uid);
      return exists(path) && get(path).data.enabled == true;
    }

    function canReadRoom(room) {
      return signedIn()
        && room.status == 'active'
        && hasValidParticipants(room)
        && request.auth.uid in room.participantUids
        && accessEnabled(room.participantUids[0])
        && accessEnabled(room.participantUids[1]);
    }
  }
}
